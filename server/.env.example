# Configuration de l'application
# Copiez ce fichier en .env et remplissez avec vos vraies valeurs

# Sécurité JWT
SECRET_KEY=changez-cette-cle-secrete-en-production-utilisez-openssl-rand-hex-32

# Configuration Email (Gmail SMTP)
# Pour obtenir un App Password Gmail :
# 1. Allez sur https://myaccount.google.com/apppasswords
# 2. Créez un nouveau mot de passe d'application
# 3. Copiez-le ici (format: xxxx xxxx xxxx xxxx)
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-app-password-gmail
EMAILS_FROM_EMAIL=votre-email@gmail.com
EMAILS_FROM_NAME=WestAf E-Commerce

# Base de données
DATABASE_URL=sqlite:///./westafecom.db
