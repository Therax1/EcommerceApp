# Configuration de l'API Backend
VITE_API_URL=http://localhost:5000/api

# Environnement (development, production, staging)
VITE_APP_ENV=development

# Configuration de l'application
VITE_APP_NAME=WestAf-Ecom
VITE_APP_VERSION=1.0.0

# Configuration des paiements (à remplir plus tard)
# VITE_STRIPE_PUBLIC_KEY=pk_test_...
# VITE_ORANGE_MONEY_API_KEY=...
# VITE_WAVE_API_KEY=...

# Configuration des images
VITE_MAX_IMAGE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Configuration de pagination par défaut
VITE_DEFAULT_PAGE_SIZE=12

# Google Analytics (optionnel)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
